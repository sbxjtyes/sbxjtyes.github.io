# 复制这个文件为 .env，填入你自己的信息。
# .env 只存在你本地，不会被上传或分享。

# 你的真实 Gmail 地址（收件箱基础账号）
GMAIL_ADDRESS=youraccount@gmail.com

# Google 应用专用密码（16 位，去 Google 账号 -> 安全 -> 两步验证 -> 应用专用密码 生成）
# 填的是应用专用密码，不是你平时登录 Gmail 的密码。带不带空格都行。
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 可选：网页监听地址/端口
# TEMPMAIL_WEB_HOST=127.0.0.1
# TEMPMAIL_WEB_PORT=8000
